    {
      "parameters": {
        "jsCode": "const d = $('When Executed by Another Workflow').first().json;\nconst m = n => 'N' + (Number(n) / 1e6).toFixed(2) + 'm';\nconst price = Number(d.fuel_price || 1250);\nconst pct = Math.round((price - 1250) / 1250 * 100);\nconst extra = 2880 * (price - 1250);\nconst inv = (d.open_invoices || [])[0];\nconst urgency = d.risk_state === 'CRITICAL' ? 'CRITICAL'\n  : d.risk_state === 'AT_RISK' ? 'HIGH' : 'MEDIUM';\nreturn [{ json: {\n  company_id: d.company_id,\n  run_id: d.run_id,\n  risk_state: d.risk_state,\n  summary: `Cash is projected to fall to ${m(d.minimum_projected_balance)} on Day ${d.day_of_minimum}, below the N4.00m safety buffer.`,\n  cause: `Diesel has risen ${pct}% to N${price} per litre, adding ${m(extra)} to each weekly fuel payment.`,\n  urgency,\n  actions: [\n    inv ? `Ask ${inv.client_name} to pay ${inv.invoice_id} (${m(inv.amount)}) early, offering a 2% early-payment discount.`\n        : 'Ask the largest client with an open invoice to pay early, offering a 2% discount.',\n    `Ask Harbour Fuels to split the next fuel payment (${m(2880 * price)}) into two instalments.`,\n    'Apply a temporary fuel surcharge to new invoices and review routes to cut fuel use by 10%.'\n  ],\n  ai_source: 'fallback',\n  action_taken: 'fallback'\n} }];"
      },
      "id": "e95024cd-b082-4336-994d-472fe2593aa0",
      "name": "Build Fallback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
