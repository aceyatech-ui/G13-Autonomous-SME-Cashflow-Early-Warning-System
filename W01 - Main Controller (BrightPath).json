        "jsCode": "function latest(names) {\n  for (const n of names) {\n    try {\n      const items = $(n).all();\n      if (items && items.length) return items[0].json;\n    } catch (e) {}\n  }\n  return null;\n}\n\n// W01 - Build a failure record when any sub-workflow call fails\nconst j = $json;\nlet stage = 'UNKNOWN';\ntry { stage = $prevNode.name; } catch (e) {}\n\nconst ctx = latest([\n  'Merge W06 Result', 'Merge W05 Result', 'Merge W04 Result',\n  'Merge W03 Result', 'Merge W02 Result'\n]) || $('Create Run Context').first().json;\n\nconst err = j.error || {};\nconst message = err.message || (typeof err === 'string' ? err : 'Unknown error');\n\nreturn [{\n  json: {\n    ...ctx,\n    failure: {\n      failed_stage: stage,\n      message: message,\n      failed_at: new Date().toISOString()\n    },\n    component: 'W01',\n    audit_event: 'STAGE_FAILED',\n    severity: 'ERROR'\n  }\n}];"
      },
