        "jsCode": "// W01 - Create Run Context (works for the daily schedule and the event webhook)\nconst j = $json;\nconst isWebhook = j.body !== undefined || j.headers !== undefined;\nconst body = isWebhook ? (j.body || {}) : {};\n\nconst now = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst stamp = `${now.getUTCFullYear()}${pad(now.getUTCMonth() + 1)}${pad(now.getUTCDate())}-${pad(now.getUTCHours())}${pad(now.getUTCMinutes())}${pad(now.getUTCSeconds())}`;\nconst rand = Math.random().toString(36).slice(2, 6).toUpperCase();\nconst day = body.day ?? body.event_day;\n\nreturn [{\n  json: {\n    run_id: `RUN-${stamp}-${rand}`,\n    started_at: now.toISOString(),\n    trigger_type: isWebhook ? 'WEBHOOK' : 'SCHEDULE',\n    company_id: body.company_id || 'BP-001',\n    horizon_days: Number(body.horizon_days) || 30,\n    current_day: (day === undefined || day === null || day === '') ? null : Number(day),\n    event_type: isWebhook ? (body.event_type || null) : null,\n    event: isWebhook ? body : null,\n    needs_ingestion: isWebhook\n  }\n}];"
      },
