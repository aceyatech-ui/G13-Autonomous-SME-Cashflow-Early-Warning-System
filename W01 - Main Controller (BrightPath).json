      "parameters": {
        "jsCode": "// W01 - Build the final run summary (input is the run context from any path)\nconst ctx = $json;\nconst validStates = ['HEALTHY', 'WATCH', 'AT_RISK', 'CRITICAL'];\n\nlet runStatus = 'COMPLETED';\nlet auditEvent = 'RUN_COMPLETED';\n\nif (ctx.ingestion && ctx.continue_run === false) {\n  runStatus = ctx.ingestion.status === 'duplicate' ? 'SKIPPED_DUPLICATE_EVENT' : 'REJECTED_INVALID_EVENT';\n  auditEvent = 'RUN_ENDED_EARLY';\n} else if (!ctx.risk || !validStates.includes(ctx.risk.risk_state)) {\n  runStatus = 'FAILED_UNKNOWN_RISK_STATE';\n  auditEvent = 'RUN_FAILED';\n}\n\nconst finished = new Date();\nconst started = new Date(ctx.started_at);\nconst stages = [];\nif (ctx.ingestion) stages.push('W02');\nif (ctx.forecast) stages.push('W03');\nif (ctx.risk) stages.push('W04');\nif (ctx.ai) stages.push('W05');\nif (ctx.approval) stages.push('W06');\nif (ctx.notification) stages.push('W07');\n\nconst summary = {\n  run_id: ctx.run_id,\n  company_id: ctx.company_id,\n  trigger_type: ctx.trigger_type,\n  event_type: ctx.event_type,\n  started_at: ctx.started_at,\n  finished_at: finished.toISOString(),\n  duration_seconds: Math.round((finished - started) / 1000),\n  run_status: runStatus,\n  risk_state: ctx.risk ? ctx.risk.risk_state : null,\n  state_changed: ctx.risk ? ctx.risk.state_changed : null,\n  minimum_projected_balance: ctx.forecast ? ctx.forecast.minimum_projected_balance : null,\n  day_of_minimum: ctx.forecast ? ctx.forecast.day_of_minimum : null,\n  days_to_breach: ctx.forecast ? ctx.forecast.days_to_breach : null,\n  approval_decision: ctx.approval ? ctx.approval.decision : null,\n  notification_sent: ctx.notification ? ctx.notification.sent : null,\n  stages_run: stages\n};\n\nreturn [{\n  json: {\n    ...ctx,\n    run_summary: summary,\n    component: 'W01',\n    audit_event: auditEvent\n  }\n}];"
      },
