{
  "name": "W04-Risk Engine",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const f = $('When Executed by Another Workflow').first().json;\nconst rows = $('Get Previous State').all()\n  .map(i => i.json).filter(r => r.id);\nrows.sort((a, b) => b.id - a.id);\nconst previous = rows.length ? rows[0].risk_state : 'HEALTHY';\n\nconst min = Number(f.minimum_projected_balance);\nlet state = 'HEALTHY';\nif (min < 1000000) state = 'CRITICAL';\nelse if (min < 3000000) state = 'AT_RISK';\nelse if (min < 5000000) state = 'WATCH';\n\nconst reason = `Lowest projected balance N${(min/1e6).toFixed(2)}m on Day ${f.day_of_minimum} (${state}).`;\n\nreturn [{ json: {\n  ...f,\n  risk_state: state,\n  previous_state: previous,\n  state_changed: state !== previous,\n  reason\n}}];"
      },
