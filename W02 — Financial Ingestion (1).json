        "jsCode": "const incomingEvent = $('Validate & Normalize Event').first().json;\n\nconst existingEvents = $input.all();\n\nconst duplicate = existingEvents.some(\n  item => item.json.event_id === incomingEvent.event_id\n);\n\nreturn [\n  {\n    json: {\n      ...incomingEvent,\n      is_duplicate: duplicate\n    }\n  }\n];"
