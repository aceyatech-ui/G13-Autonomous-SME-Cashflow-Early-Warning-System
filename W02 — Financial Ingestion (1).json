    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body ?? $json.event ?? $json;\n\nconst errors = [];\n\n// --------------------------------------------------\n// COMMON REQUIRED FIELDS\n// --------------------------------------------------\n\nif (!body.event_type) {\n  errors.push(\"Missing required field: event_type\");\n}\n\nif (!body.company_id) {\n  errors.push(\"Missing required field: company_id\");\n}\n\nif (!body.event_id) {\n  errors.push(\"Missing required field: event_id\");\n}\n\n\n// --------------------------------------------------\n// FUEL PRICE UPDATE\n// --------------------------------------------------\n\nif (body.event_type === \"fuel_price_update\") {\n\n  if (!body.fuel) {\n    errors.push(\"Missing required field: fuel\");\n  }\n\n  if (body.old_price === undefined || body.old_price === null) {\n    errors.push(\"Missing required field: old_price\");\n  } else if (\n    typeof body.old_price !== \"number\" ||\n    !Number.isFinite(body.old_price)\n  ) {\n    errors.push(\"old_price must be a valid number\");\n  } else if (body.old_price <= 0) {\n    errors.push(\"old_price must be greater than zero\");\n  }\n\n  if (body.new_price === undefined || body.new_price === null) {\n    errors.push(\"Missing required field: new_price\");\n  } else if (\n    typeof body.new_price !== \"number\" ||\n    !Number.isFinite(body.new_price)\n  ) {\n    errors.push(\"new_price must be a valid number\");\n  } else if (body.new_price <= 0) {\n    errors.push(\"new_price must be greater than zero\");\n  }\n}\n\n\n// --------------------------------------------------\n// PAYMENT RECEIVED\n// --------------------------------------------------\n\nelse if (body.event_type === \"payment_received\") {\n\n  if (!body.invoice_id) {\n    errors.push(\"Missing required field: invoice_id\");\n  }\n\n  if (body.amount === undefined || body.amount === null) {\n    errors.push(\"Missing required field: amount\");\n  } else if (\n    typeof body.amount !== \"number\" ||\n    !Number.isFinite(body.amount)\n  ) {\n    errors.push(\"amount must be a valid number\");\n  } else if (body.amount <= 0) {\n    errors.push(\"amount must be greater than zero\");\n  }\n\n  if (body.payment_day === undefined || body.payment_day === null) {\n    errors.push(\"Missing required field: payment_day\");\n  } else if (\n    typeof body.payment_day !== \"number\" ||\n    !Number.isInteger(body.payment_day)\n  ) {\n    errors.push(\"payment_day must be an integer\");\n  } else if (body.payment_day < 0) {\n    errors.push(\"payment_day cannot be negative\");\n  }\n\n  if (!body.reference) {\n    errors.push(\"Missing required field: reference\");\n  }\n}\n\n\n// --------------------------------------------------\n// INVOICE CREATED\n// --------------------------------------------------\n\nelse if (body.event_type === \"invoice_created\") {\n\n  if (!body.invoice_id) {\n    errors.push(\"Missing required field: invoice_id\");\n  }\n\n  if (!body.client_name) {\n    errors.push(\"Missing required field: client_name\");\n  }\n\n  if (body.amount === undefined || body.amount === null) {\n    errors.push(\"Missing required field: amount\");\n  } else if (\n    typeof body.amount !== \"number\" ||\n    !Number.isFinite(body.amount)\n  ) {\n    errors.push(\"amount must be a valid number\");\n  } else if (body.amount <= 0) {\n    errors.push(\"amount must be greater than zero\");\n  }\n\n  if (body.due_day === undefined || body.due_day === null) {\n    errors.push(\"Missing required field: due_day\");\n  } else if (\n    typeof body.due_day !== \"number\" ||\n    !Number.isInteger(body.due_day)\n  ) {\n    errors.push(\"due_day must be an integer\");\n  } else if (body.due_day < 0) {\n    errors.push(\"due_day cannot be negative\");\n  }\n\n  if (body.status !== undefined && body.status !== null) {\n    const allowedStatuses = [\n      \"Open\",\n      \"Paid\",\n      \"Overdue\",\n      \"Cancelled\"\n    ];\n\n    if (!allowedStatuses.includes(body.status)) {\n      errors.push(\n        `Invalid invoice status: ${body.status}`\n      );\n    }\n  }\n}\n\n\n// --------------------------------------------------\n// UNSUPPORTED EVENT TYPE\n// --------------------------------------------------\n\nelse if (\n  body.event_type &&\n  body.event_type !== \"fuel_price_update\" &&\n  body.event_type !== \"payment_received\" &&\n  body.event_type !== \"invoice_created\"\n) {\n  errors.push(`Unsupported event_type: ${body.event_type}`);\n}\n\n\n// --------------------------------------------------\n// NORMALIZED OUTPUT\n// --------------------------------------------------\n\nreturn {\n  json: {\n    event_type: body.event_type ?? null,\n    company_id: body.company_id ?? null,\n    event_id: body.event_id ?? null,\n\n    // Fuel\n    fuel: body.fuel ?? null,\n    old_price: body.old_price ?? null,\n    new_price: body.new_price ?? null,\n\n    // Payment\n    invoice_id: body.invoice_id ?? null,\n    amount: body.amount ?? null,\n    payment_day: body.payment_day ?? null,\n    reference: body.reference ?? null,\n\n    // Invoice\n    client_name: body.client_name ?? null,\n    due_day: body.due_day ?? null,\n    status: body.status ?? null,\n\n    is_valid: errors.length === 0,\n    validation_errors: errors\n  }\n};"
      },
